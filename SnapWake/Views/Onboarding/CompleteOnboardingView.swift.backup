            VStack(spacing: 40) {
                Text("\"\"")
                    .font(.faroBold(size: 80))
                    .foregroundColor(Color.snapBorder(for: colorScheme))

                VStack(spacing: 8) {
                    Text("If you win")
                        .font(.faroBold(size: 42))
                        .foregroundColor(.black)

                    Text("the morning,")
                        .font(.faroBold(size: 42))
                        .foregroundColor(.black)

                    Text("you win the day.")
                        .font(.faroBold(size: 42))
