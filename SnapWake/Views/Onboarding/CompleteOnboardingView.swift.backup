    // Helper functions pour les icônes de mission
    func getMissionIcon(for mission: String) -> some View {
        let (iconName, gradient) = getMissionIconInfo(for: mission)

        return ZStack {
            Circle()
                .fill(
                    LinearGradient(
                        colors: gradient,
                        startPoint: .topLeading,
                        endPoint: .bottomTrailing
                    )
                )
                .frame(width: 120, height: 120)

            Image(systemName: iconName)
                .font(.faroBold(size: 50))
                .foregroundColor(.white)
        }
    }

    func getMissionIconInfo(for mission: String) -> (String, [Color]) {
        switch mission {
        case "Pompes":
            return ("figure.strengthtraining.traditional", [Color(hex: "FF6B6B"), Color(hex: "FF4757")])
        case "Photo du ciel":
            return ("camera.fill", [Color(hex: "4A90E2"), Color(hex: "357ABD")])
        case "Faire ton lit":
            return ("bed.double.fill", [Color(hex: "9B59B6"), Color(hex: "8E44AD")])
        case "Verset biblique":
            return ("book.fill", [Color(hex: "F39C12"), Color(hex: "E67E22")])
        case "Affirmation":
            return ("sparkles", [Color(hex: "FFD700"), Color(hex: "FFA500")])
        case "Chasse à l'objet":
            return ("magnifyingglass", [Color(hex: "00A86B"), Color(hex: "00D084")])
        case "Marcher":
            return ("figure.walk", [Color.snapOrange, Color(hex: "FF8C00")])
        case "Problème de maths":
            return ("brain.head.profile", [Color(hex: "3498DB"), Color(hex: "2980B9")])
        default:
            return ("star.fill", [Color.snapOrange, Color(hex: "FF8C00")])
        }
    }

    func getMissionInstruction(for mission: String) -> String {
        switch mission {
        case "Pompes":
            return "Fais 15 secondes de pompes"
        case "Photo du ciel":
            return "Prends le ciel en photo"
        case "Faire ton lit":
            return "Montre un lit fait"
        case "Verset biblique":
            return "Dis un court verset"
        case "Affirmation":
            return "Lis une affirmation"
        case "Chasse à l'objet":
            return "Trouve un objet"
        case "Marcher":
            return "Fais quelques pas"
        case "Problème de maths":
            return "Résous un calcul"
        default:
            return "Complète ta mission"
        }
    }

    // MARK: - Days Selection
    var daysSelectionView: some View {
        VStack(spacing: 0) {
            Spacer().frame(height: 20)

            Text("Quels jours veux-tu que\nCocorise sonne?")
                .font(.faroBold(size: 24))
                .foregroundColor(.black)
                .multilineTextAlignment(.leading)
                .frame(maxWidth: .infinity, alignment: .leading)
                .padding(.horizontal, 32)
                .padding(.bottom, 20)

            VStack(spacing: 16) {
                ForEach(["Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi", "Samedi", "Dimanche"], id: \.self) { day in
                    Button(action: {
                        if selectedDays.contains(day) {
                            selectedDays.remove(day)
                        } else {
                            selectedDays.insert(day)
                        }
                    }) {
                        HStack(spacing: 16) {
                            ZStack {
                                Circle()
                                    .stroke(selectedDays.contains(day) ? Color.snapOrange : Color.snapDivider(for: colorScheme), lineWidth: 2)
                                    .frame(width: 28, height: 28)

                                if selectedDays.contains(day) {
                                    Circle()
                                        .fill(Color.snapOrange)
                                        .frame(width: 28, height: 28)

                                    Image(systemName: "checkmark")
                                        .font(.faroBold(size: 12))
                                        .foregroundColor(.white)
                                }
                            }

                            Text(day)
                                .font(.faro(size: 17))
                                .foregroundColor(.black)
                                .frame(maxWidth: .infinity, alignment: .leading)
                        }
                        .padding(.vertical, 12)
                        .padding(.horizontal, 24)
                        .background(selectedDays.contains(day) ? Color.white : Color.snapOrange.opacity(0.15))
                        .overlay(
                            RoundedRectangle(cornerRadius: 40)
                                .stroke(Color.snapOrange, lineWidth: selectedDays.contains(day) ? 2 : 0)
                        )
                        .cornerRadius(40)
                    }
                }
            }
            .padding(.horizontal, 32)

            Spacer()

            Button(action: {
                withAnimation {
                    currentStep += 1
                }
            }) {
                Text("Continue")
                    .font(.faroBold(size: 17))
                    .foregroundColor(.white)
                    .frame(maxWidth: .infinity)
                    .padding(.vertical, 18)
                    .background(!selectedDays.isEmpty ? Color.snapOrange : Color.gray.opacity(0.3))
                    .cornerRadius(30)
            }
            .disabled(selectedDays.isEmpty)
            .padding(.horizontal, 32)
            .padding(.bottom, 40)
        }
        .background(Color.snapLightBackground)
    }

