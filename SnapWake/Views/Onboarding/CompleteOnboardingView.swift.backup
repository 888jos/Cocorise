    // MARK: - Loading
    var loadingView: some View {
        VStack(spacing: 40) {
            Spacer()

            Text("\(Int(loadingProgress))%")
                .font(.faroBold(size: 80))
                .foregroundColor(Color.snapOrange)

            Text("On prépare tout\npour toi...")
                .font(.faroBold(size: 28))
                .foregroundColor(Color.snapOrange)
                .multilineTextAlignment(.center)

            ProgressView(value: loadingProgress, total: 100)
                .tint(LinearGradient(colors: [.orange, .pink, .purple], startPoint: .leading, endPoint: .trailing))
                .scaleEffect(y: 2)
                .padding(.horizontal, 32)

            Text(loadingProgress < 30 ? "Configuration de tes objectifs..." :
                 loadingProgress < 60 ? "Préparation de ta mission..." :
                 loadingProgress < 80 ? "Paramétrage du son d'alarme..." :
                 "Planification de ton alarme...")
                .font(.faro(size: 15))
                .foregroundColor(.gray)

            VStack(alignment: .leading, spacing: 12) {
                progressItem("Configuration de tes objectifs", loadingProgress >= 30)
                progressItem("Préparation de ta mission", loadingProgress >= 60)
                progressItem("Paramétrage du son d'alarme", loadingProgress >= 80)
                progressItem("Planification de ton alarme", loadingProgress >= 90)
                progressItem("Création de ton compte", loadingProgress >= 100)
            }
            .padding(24)
            .background(Color(.systemGray6))
            .cornerRadius(16)
            .padding(.horizontal, 32)

            Spacer()
        }
        .background(Color.snapLightBackground)
        .onAppear {
            animateLoading()
        }
    }

    func progressItem(_ text: String, _ isDone: Bool) -> some View {
        HStack {
            Text(text)
                .font(.faro(size: 15))
                .foregroundColor(isDone ? Color.snapOrange : .gray)
            Spacer()
            Image(systemName: isDone ? "checkmark.circle.fill" : "circle")
                .foregroundColor(isDone ? .green : .gray)
        }
    }

    func animateLoading() {
        withAnimation(.linear(duration: 4.0)) {
            loadingProgress = 100
        }
        DispatchQueue.main.asyncAfter(deadline: .now() + 4.5) {
            withAnimation {
                currentStep += 1
            }
        }
    }

